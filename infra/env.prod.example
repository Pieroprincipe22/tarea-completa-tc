# ============================================================
# AnPi Tech · variables de PRODUCCIÓN
# Copia este archivo a infra/.env.prod (está en .gitignore) y rellénalo.
# Genera cada secreto con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ============================================================

# --- Dominios (los dos con un registro DNS A apuntando al servidor) ---
APP_DOMAIN=app.tudominio.com
API_DOMAIN=api.tudominio.com
# Solo con MinIO: dominio público de los archivos (fotos, PDF)
FILES_DOMAIN=files.tudominio.com
# Email para los avisos de Let's Encrypt sobre los certificados
ACME_EMAIL=tu@email.com

# --- Base de datos ---
POSTGRES_USER=anpi
POSTGRES_PASSWORD=CAMBIA_ESTO
POSTGRES_DB=anpi

# --- Seguridad ---
JWT_ACCESS_SECRET=CAMBIA_ESTO
JWT_ACCESS_EXPIRES_IN=12h
ADMIN_KEY=CAMBIA_ESTO

# --- Archivos (S3) ---
# Opción A, MinIO en este servidor (arranca con --profile minio). El endpoint es
# el dominio público, porque los enlaces de descarga los abre el navegador:
#   S3_ENDPOINT=https://files.tudominio.com   S3_REGION=us-east-1
# Opción B, Cloudflare R2 (borra el bloque FILES_DOMAIN del Caddyfile):
#   S3_ENDPOINT=https://<id-cuenta>.r2.cloudflarestorage.com   S3_REGION=auto
# El bucket se crea solo al arrancar la API si no existe.
S3_ENDPOINT=https://files.tudominio.com
S3_REGION=us-east-1
S3_ACCESS_KEY=CAMBIA_ESTO
S3_SECRET_KEY=CAMBIA_ESTO
S3_BUCKET=anpi-tech
S3_PRESIGN_EXP_SECONDS=3600

# --- Emails (recuperación de contraseña) ---
RESEND_API_KEY=
MAIL_FROM=AnPi Tech <no-reply@tudominio.com>
# Email que aparece en «Solicita acceso» del login (opcional)
CONTACT_EMAIL=

# --- Copias de seguridad ---
BACKUP_KEEP_DAYS=14

# --- Observabilidad (opcional) ---
SENTRY_DSN=
