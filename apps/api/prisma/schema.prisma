generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  TECHNICIAN
  SUPER_ADMIN
}

enum WorkOrderStatus {
  OPEN
  ASSIGNED
  PENDING
  IN_PROGRESS
  DONE
  CANCELLED
}

enum WorkOrderPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum AssetStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
  RETIRED
}

enum MaintenanceItemType {
  TEXT
  LONG_TEXT
  TEXTAREA
  NUMBER
  BOOLEAN
  DATE
  CHECKBOX
  CHECKLIST
  PHOTO
  SIGNATURE
  // Estado: el técnico elige una de las opciones que define la empresa.
  CHOICE
}

enum MaintenanceItemStatus {
  PENDING
  OK
  FAIL
  NA
}

enum MaintenanceReportStatus {
  DRAFT
  ASSIGNED
  IN_PROGRESS
  SUBMITTED
  COMPLETED
  APPROVED
  REJECTED
  CANCELLED
}

enum MaintenanceReportState {
  DRAFT
  FINAL
}

enum AttachmentOwnerType {
  WORK_ORDER
  MAINTENANCE_REPORT
  MAINTENANCE_REPORT_ITEM
  ASSET
  SITE
  CUSTOMER
  MAINTENANCE_TEMPLATE
  EMERGENCY_REQUEST
  INVOICE
  OTHER
}

enum EmergencyRequestStatus {
  OPEN
  DISPATCHED
  IN_PROGRESS
  DONE
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  GENERATED
  SENT
  PAID
  CANCELLED
}

enum CompanyPlan {
  BASIC
  PRO
  ENTERPRISE
}

enum SpaceKind {
  ROOM // Habitación
  COMMON // Zona común: recepción, cocina, cuarto de rack…
}

// Cada cuánto se repite un plan preventivo.
enum PlanIntervalUnit {
  WEEK
  MONTH
}

enum RoundStatus {
  OPEN // Creada, sin empezar
  IN_PROGRESS // Ya hay equipos revisados
  DONE // Cerrada
  CANCELLED
}

enum RoundStopStatus {
  PENDING
  DONE
  NO_ACCESS // No se pudo entrar: se vuelve otro día
}

model Company {
  id        String      @id @default(cuid())
  name      String
  slug      String?     @unique
  isActive  Boolean     @default(true)
  existe    Boolean     @default(true)
  plan          CompanyPlan @default(BASIC)
  invoicePrefix String?

  // Numeración de documentos: PREFIJO-AÑO-NÚMERO (OT-2026-0001, P-2026-0001…)
  workOrderPrefix String @default("OT")
  quotePrefix     String @default("P")

  // Datos de la empresa (los edita su administrador en Configuración → Empresa)
  legalName      String?
  taxId          String?
  addressLine    String?
  postalCode     String?
  city           String?
  province       String?
  country        String?  @default("España")
  phone          String?
  email          String?
  website        String?
  iban           String?
  defaultTaxRate Decimal  @default(21) @db.Decimal(5, 2)
  logoKey        String?
  createdAt     DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  users                User[]
  userCompanies        UserCompany[]
  customers            Customer[]
  sites                Site[]
  contacts             Contact[]
  assets               Asset[]
  workOrders           WorkOrder[]
  maintenanceTemplates MaintenanceTemplate[]
  maintenanceReports   MaintenanceReport[]
  attachments          Attachment[]
  counters             CompanyCounter[]
  emergencyRequests    EmergencyRequest[]
  invoices             Invoice[]
  floors               Floor[]
  spaces               Space[]
  maintenancePlans     MaintenancePlan[]
  maintenanceRounds    MaintenanceRound[]
  roundStops           RoundStop[]
}

model User {
  id           String    @id @default(cuid())
  companyId    String?
  name         String
  email        String    @unique
  passwordHash String
  role         UserRole?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  memberships                     UserCompany[]
  createdWorkOrders               WorkOrder[]         @relation("WorkOrderCreatedBy")
  assignedTechnicianWorkOrders    WorkOrder[]         @relation("WorkOrderAssignedTechnician")
  assignedToWorkOrders            WorkOrder[]         @relation("WorkOrderAssignedTo")
  createdMaintenanceReports       MaintenanceReport[] @relation("MaintenanceReportCreatedBy")
  legacyCreatedMaintenanceReports MaintenanceReport[] @relation("MaintenanceReportCreatedByUser")
  completedMaintenanceReports     MaintenanceReport[] @relation("MaintenanceReportCompletedByUser")
  assignedMaintenanceReports      MaintenanceReport[] @relation("MaintenanceReportAssignedTechnician")
  submittedMaintenanceReports     MaintenanceReport[] @relation("MaintenanceReportSubmittedBy")
  reviewedMaintenanceReports      MaintenanceReport[] @relation("MaintenanceReportReviewedBy")
  uploadedAttachments             Attachment[]        @relation("AttachmentUploadedByUser")
  assignedEmergencyRequests       EmergencyRequest[]  @relation("EmergencyRequestAssignedTo")
  passwordResetTokens             PasswordResetToken[]
  maintenancePlans                MaintenancePlan[]   @relation("MaintenancePlanTechnician")
  closedMaintenanceRounds         MaintenanceRound[]  @relation("MaintenanceRoundClosedBy")
  doneRoundStops                  RoundStop[]         @relation("RoundStopDoneBy")

  @@index([companyId])
  @@index([companyId, role])
}

model UserCompany {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  role      UserRole
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId, role, active])
}

model Customer {
  id        String   @id @default(cuid())
  companyId String
  name      String
  email     String?
  phone     String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sites              Site[]
  assets             Asset[]
  workOrders         WorkOrder[]
  maintenanceReports MaintenanceReport[]
  emergencyRequests  EmergencyRequest[]

  @@index([companyId, name])
}

model Site {
  id         String   @id @default(cuid())
  companyId  String
  customerId String
  name       String
  address    String?
  city       String?
  country    String?
  notes      String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer           Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  contacts           Contact[]
  assets             Asset[]
  workOrders         WorkOrder[]
  maintenanceReports MaintenanceReport[]
  emergencyRequests  EmergencyRequest[]
  floors             Floor[]
  spaces             Space[]
  maintenancePlans   MaintenancePlan[]
  maintenanceRounds  MaintenanceRound[]

  @@index([companyId, customerId, name])
}

// Planta o nivel de un sitio: "Planta baja", "Planta 3", "Sótano -1", "Cubierta".
model Floor {
  id        String   @id @default(cuid())
  companyId String
  siteId    String
  // Orden de abajo arriba: -1 sótano, 0 planta baja, 1, 2, 3…
  level     Int
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  site    Site    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  spaces  Space[]

  // Un sitio no puede tener dos plantas en el mismo nivel.
  @@unique([siteId, level])
  @@index([companyId, siteId])
}

// Habitación o zona común dentro de una planta.
model Space {
  id        String    @id @default(cuid())
  companyId String
  siteId    String
  floorId   String
  kind      SpaceKind @default(ROOM)
  // Habitación: su número ("204"). Zona común: su nombre ("Recepción").
  name      String
  // Tipo de zona común ("Cocina", "Cuarto de rack"…). Texto libre.
  category  String?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  site       Site        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  floor      Floor       @relation(fields: [floorId], references: [id], onDelete: Cascade)
  assets     Asset[]
  roundStops RoundStop[]

  // En una planta no se repite el nombre (dos "Office" en plantas distintas sí).
  @@unique([floorId, name])
  @@index([companyId, siteId])
  @@index([siteId, kind])
}

model Contact {
  id        String   @id @default(cuid())
  companyId String
  siteId    String
  name      String
  email     String?
  phone     String?
  role      String?
  isMain    Boolean  @default(false)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  site    Site    @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([companyId, siteId])
}

model Asset {
  id             String      @id @default(cuid())
  companyId      String
  customerId     String?
  siteId         String?
  // Habitación o zona donde está el equipo (opcional).
  spaceId        String?
  name           String
  code           String?
  internalCode   String?
  category       String?
  brand          String?
  model          String?
  serialNumber   String?
  status         AssetStatus @default(ACTIVE)
  installationAt DateTime?
  location       String?
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer           Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  site               Site?               @relation(fields: [siteId], references: [id], onDelete: SetNull)
  space              Space?              @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  workOrders         WorkOrder[]
  maintenanceReports MaintenanceReport[]
  emergencyRequests  EmergencyRequest[]
  roundStops         RoundStop[]

  @@index([companyId, name])
  @@index([customerId])
  @@index([siteId])
  @@index([spaceId])
}

model MaintenanceTemplate {
  id          String   @id @default(cuid())
  companyId   String
  name        String?
  title       String?
  description String?
  // Tipo de equipo al que se aplica (Split, VRF, Enfriadora…). Texto libre.
  category    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company            Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items              MaintenanceTemplateItem[]
  workOrders         WorkOrder[]
  maintenanceReports MaintenanceReport[]
  maintenancePlans   MaintenancePlan[]
  maintenanceRounds  MaintenanceRound[]

  @@index([companyId, isActive])
  @@index([companyId, name])
  @@index([companyId, title])
}

model MaintenanceTemplateItem {
  id          String               @id @default(cuid())
  templateId  String
  label       String?
  title       String?
  description String?
  type        MaintenanceItemType?
  valueType   String?
  required    Boolean              @default(false)
  sortOrder   Int                  @default(0)
  itemOrder   Int                  @default(0)
  unit        String?
  helpText    String?
  placeholder String?
  // Sección de la hoja a la que pertenece el punto ("Unidad exterior"…).
  section     String?
  // Rango aceptable de una medición: fuera de él, el parte lo marca.
  minValue    Float?
  maxValue    Float?
  // Opciones de un punto de tipo Estado: [{ "label": "Bien", "result": "OK" }, …]
  // "result" es OK (correcto), ISSUE (incidencia) o NA (no aplica).
  options     Json?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  template    MaintenanceTemplate     @relation(fields: [templateId], references: [id], onDelete: Cascade)
  reportItems MaintenanceReportItem[]

  @@index([templateId, sortOrder])
  @@index([templateId, itemOrder])
}

model WorkOrder {
  id                    String            @id @default(cuid())
  companyId             String
  customerId            String?
  siteId                String?
  assetId               String?
  createdById           String?
  assignedTechnicianId  String?
  assignedToUserId      String?
  maintenanceTemplateId String?
  code                  String?
  title                 String
  description           String?
  status                WorkOrderStatus   @default(OPEN)
  priority              WorkOrderPriority @default(MEDIUM)
  scheduledFor          DateTime?
  scheduledAt           DateTime?
  startedAt             DateTime?
  completedAt           DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  company             Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer            Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  site                Site?                @relation(fields: [siteId], references: [id], onDelete: SetNull)
  asset               Asset?               @relation(fields: [assetId], references: [id], onDelete: SetNull)
  createdBy           User?                @relation("WorkOrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  assignedTechnician  User?                @relation("WorkOrderAssignedTechnician", fields: [assignedTechnicianId], references: [id], onDelete: SetNull)
  assignedTo          User?                @relation("WorkOrderAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  maintenanceTemplate MaintenanceTemplate? @relation(fields: [maintenanceTemplateId], references: [id], onDelete: SetNull)
  maintenanceReport   MaintenanceReport?
  invoice             Invoice?
  // Si la orden es una ronda (muchos equipos, uno detrás de otro).
  round               MaintenanceRound?

  @@index([companyId, status])
  @@index([assignedTechnicianId, status])
  @@index([assignedToUserId, status])
  @@index([customerId])
  @@index([siteId])
  @@index([assetId])
  @@index([maintenanceTemplateId])
  // Una empresa no puede tener dos órdenes con el mismo número.
  @@unique([companyId, code])
}

model MaintenanceReport {
  id                   String                  @id @default(cuid())
  companyId            String
  workOrderId          String?                 @unique
  // Parada de una ronda a la que pertenece este parte (un equipo de la ronda).
  roundStopId          String?                 @unique
  templateId           String?
  customerId           String?
  siteId               String?
  assetId              String?
  createdById          String?
  createdByUserId      String?
  completedByUserId    String?
  assignedTechnicianId String?
  submittedById        String?
  reviewedById         String?
  status               MaintenanceReportStatus @default(DRAFT)
  state                MaintenanceReportState  @default(DRAFT)

  title           String?
  description     String?
  notes           String?
  summary         String?
  diagnosis       String?
  workPerformed   String?
  recommendations String?
  observations    String?
  technicianNotes String?
  reviewNotes     String?

  laborHours Decimal? @db.Decimal(10, 2)
  laborDays  Decimal? @db.Decimal(10, 2)

  assignedAt  DateTime?
  startedAt   DateTime?
  submittedAt DateTime?
  completedAt DateTime?
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  pdfUrl         String?
  pdfGeneratedAt DateTime?

  company            Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workOrder          WorkOrder?                  @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  template           MaintenanceTemplate?        @relation(fields: [templateId], references: [id], onDelete: SetNull)
  customer           Customer?                   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  site               Site?                       @relation(fields: [siteId], references: [id], onDelete: SetNull)
  asset              Asset?                      @relation(fields: [assetId], references: [id], onDelete: SetNull)
  createdBy          User?                       @relation("MaintenanceReportCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdByUser      User?                       @relation("MaintenanceReportCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)
  completedByUser    User?                       @relation("MaintenanceReportCompletedByUser", fields: [completedByUserId], references: [id], onDelete: SetNull)
  assignedTechnician User?                       @relation("MaintenanceReportAssignedTechnician", fields: [assignedTechnicianId], references: [id], onDelete: SetNull)
  submittedBy        User?                       @relation("MaintenanceReportSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  reviewedBy         User?                       @relation("MaintenanceReportReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  roundStop          RoundStop?                  @relation(fields: [roundStopId], references: [id], onDelete: Cascade)
  items              MaintenanceReportItem[]
  materials          MaintenanceReportMaterial[]
  invoice            Invoice?

  @@index([companyId, status])
  @@index([assignedTechnicianId, status])
  @@index([templateId])
  @@index([customerId])
  @@index([siteId])
  @@index([assetId])
}

model MaintenanceReportItem {
  id             String                @id @default(cuid())
  reportId       String
  templateItemId String?
  label          String?
  title          String?
  description    String?
  type           MaintenanceItemType?
  valueType      String?
  required       Boolean               @default(false)
  sortOrder      Int                   @default(0)
  itemOrder      Int                   @default(0)
  unit           String?
  // Copia de la plantilla en el momento de crear el parte: si la
  // plantilla cambia después, el parte conserva cómo era.
  section        String?
  minValue       Float?
  maxValue       Float?
  options        Json?
  status         MaintenanceItemStatus @default(PENDING)
  value          String?
  notes          String?

  valueText    String?
  valueNumber  Float?
  valueBoolean Boolean?
  valueDate    DateTime?
  valueJson    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  report       MaintenanceReport        @relation(fields: [reportId], references: [id], onDelete: Cascade)
  templateItem MaintenanceTemplateItem? @relation(fields: [templateItemId], references: [id], onDelete: SetNull)

  @@index([reportId, sortOrder])
  @@index([reportId, itemOrder])
  @@index([templateItemId])
}

model MaintenanceReportMaterial {
  id            String   @id @default(cuid())
  reportId      String
  name          String
  description   String?
  quantity      Float    @default(1)
  unit          String?
  sortOrder     Int      @default(0)
  notes         String?
  unitCost      Decimal? @db.Decimal(10, 2)
  totalCost     Decimal? @db.Decimal(10, 2)
  billable      Boolean  @default(true)
  pricedByAdmin Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  report       MaintenanceReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  invoiceItems InvoiceItem[]

  @@index([reportId, sortOrder])
}

// Plan preventivo de un sitio: cada cuánto se revisa un tipo de equipo
// ("los fancoils de las habitaciones, cada 3 meses"). Cuando toca, crea
// sola una ronda con todos los equipos de ese tipo.
model MaintenancePlan {
  id                   String           @id @default(cuid())
  companyId            String
  siteId               String
  templateId           String
  // Tipo de equipo que entra en la ronda ("Fancoil"). Se compara sin
  // distinguir mayúsculas con el tipo de cada equipo del sitio.
  category             String
  name                 String
  // Cada cuánto: "every" semanas o meses.
  every                Int
  unit                 PlanIntervalUnit @default(MONTH)
  // Fecha de la primera ronda. Las siguientes se cuentan desde ella, así
  // un plan que empieza el día 31 cae siempre a final de mes.
  startsOn             DateTime
  // Fecha de la próxima ronda. Se crea "leadDays" días antes.
  nextDueAt            DateTime
  leadDays             Int              @default(7)
  assignedTechnicianId String?
  isActive             Boolean          @default(true)
  // Si la última vez no se pudo crear la ronda, el motivo.
  lastError            String?
  lastErrorAt          DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  site               Site                @relation(fields: [siteId], references: [id], onDelete: Cascade)
  template           MaintenanceTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  assignedTechnician User?               @relation("MaintenancePlanTechnician", fields: [assignedTechnicianId], references: [id], onDelete: SetNull)
  rounds             MaintenanceRound[]

  @@index([companyId, isActive, nextDueAt])
  @@index([siteId])
  @@index([templateId])
}

// Ronda de mantenimiento: una orden de trabajo que recorre muchos equipos,
// por ejemplo los 165 fancoils de un hotel. Cada equipo es una parada.
model MaintenanceRound {
  id          String      @id @default(cuid())
  companyId   String
  siteId      String
  workOrderId String      @unique
  planId      String?
  templateId  String?
  category    String
  status      RoundStatus @default(OPEN)
  // Fecha que toca según el plan (o la elegida al crearla a mano).
  dueAt       DateTime
  startedAt   DateTime?
  closedAt    DateTime?
  closedById  String?
  closeNote   String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  company   Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  site      Site                 @relation(fields: [siteId], references: [id], onDelete: Cascade)
  workOrder WorkOrder            @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  plan      MaintenancePlan?     @relation(fields: [planId], references: [id], onDelete: SetNull)
  template  MaintenanceTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  closedBy  User?                @relation("MaintenanceRoundClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  stops     RoundStop[]

  // Un plan no crea dos veces la ronda de la misma fecha.
  @@unique([planId, dueAt])
  @@index([companyId, status])
  @@index([siteId, dueAt])
}

// Una parada de la ronda: un equipo, dónde estaba y cómo quedó.
model RoundStop {
  id             String          @id @default(cuid())
  companyId      String
  roundId        String
  assetId        String?
  spaceId        String?
  // Copia de dónde estaba el equipo al crear la ronda: la ronda se sigue
  // leyendo igual aunque después se muevan equipos o habitaciones.
  floorLevel     Int?
  floorName      String?
  spaceKind      SpaceKind?
  spaceName      String?
  assetName      String
  sortOrder      Int             @default(0)
  status         RoundStopStatus @default(PENDING)
  // Por qué no se pudo entrar: ocupada, no molestar, sin llave…
  noAccessReason String?
  hasIssue       Boolean         @default(false)
  doneAt         DateTime?
  doneById       String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  company Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  round   MaintenanceRound   @relation(fields: [roundId], references: [id], onDelete: Cascade)
  asset   Asset?             @relation(fields: [assetId], references: [id], onDelete: SetNull)
  space   Space?             @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  doneBy  User?              @relation("RoundStopDoneBy", fields: [doneById], references: [id], onDelete: SetNull)
  report  MaintenanceReport?

  @@unique([roundId, assetId])
  @@index([roundId, sortOrder])
  @@index([assetId, doneAt])
  @@index([companyId])
}

model Attachment {
  id               String              @id @default(cuid())
  companyId        String?
  ownerType        AttachmentOwnerType
  ownerId          String
  name             String?
  fileName         String?
  filename         String?
  originalName     String?
  mimeType         String?
  contentType      String?
  path             String?
  url              String?
  storageKey       String?
  size             Int?
  sizeBytes        Int?
  uploadedByUserId String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  company        Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  uploadedByUser User?    @relation("AttachmentUploadedByUser", fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([ownerType, ownerId])
}

model CompanyCounter {
  id        String   @id @default(cuid())
  companyId String
  key       String
  value     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, key])
}

model EmergencyRequest {
  id               String                 @id @default(cuid())
  companyId        String
  customerId       String?
  siteId           String?
  assetId          String?
  assignedToUserId String?
  title            String
  description      String?
  status           EmergencyRequestStatus @default(OPEN)
  priority         WorkOrderPriority      @default(MEDIUM)
  requestedByName  String?
  requestedByPhone String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  site       Site?     @relation(fields: [siteId], references: [id], onDelete: SetNull)
  asset      Asset?    @relation(fields: [assetId], references: [id], onDelete: SetNull)
  assignedTo User?     @relation("EmergencyRequestAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  @@index([companyId, status])
  @@index([customerId])
  @@index([siteId])
  @@index([assetId])
  @@index([assignedToUserId])
}

model Invoice {
  id                  String        @id @default(cuid())
  companyId           String
  workOrderId         String?       @unique
  maintenanceReportId String?       @unique
  invoiceNumber       String?
  status              InvoiceStatus @default(DRAFT)
  currency            String        @default("EUR")

  laborAmount     Decimal? @db.Decimal(10, 2)
  materialsAmount Decimal? @db.Decimal(10, 2)
  subtotal        Decimal? @db.Decimal(10, 2)
  taxRate         Decimal? @db.Decimal(5, 2)
  taxAmount       Decimal? @db.Decimal(10, 2)
  total           Decimal? @db.Decimal(10, 2)

  notes       String?
  pdfUrl      String?
  generatedAt DateTime?
  sentAt      DateTime?
  paidAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workOrder         WorkOrder?         @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  maintenanceReport MaintenanceReport? @relation(fields: [maintenanceReportId], references: [id], onDelete: SetNull)
  items             InvoiceItem[]

  // El número es único dentro de cada empresa (dos empresas pueden usar el mismo prefijo).
  @@unique([companyId, invoiceNumber])
  @@index([companyId, status])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  action      String
  companyId   String?
  targetPath  String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([actorUserId, createdAt])
  @@index([companyId, createdAt])
}

model InvoiceItem {
  id                          String   @id @default(cuid())
  invoiceId                   String
  maintenanceReportMaterialId String?
  description                 String
  quantity                    Float    @default(1)
  unit                        String?
  unitPrice                   Decimal? @db.Decimal(10, 2)
  lineTotal                   Decimal? @db.Decimal(10, 2)
  sortOrder                   Int      @default(0)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  invoice                   Invoice                    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  maintenanceReportMaterial MaintenanceReportMaterial? @relation(fields: [maintenanceReportMaterialId], references: [id], onDelete: SetNull)

  @@index([invoiceId, sortOrder])
  @@index([maintenanceReportMaterialId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}