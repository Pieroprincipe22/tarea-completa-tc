generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  TECHNICIAN
  SUPER_ADMIN
}

enum WorkOrderStatus {
  OPEN
  ASSIGNED
  PENDING
  IN_PROGRESS
  DONE
  CANCELLED
}

enum WorkOrderPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum AssetStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
  RETIRED
}

enum MaintenanceItemType {
  TEXT
  LONG_TEXT
  TEXTAREA
  NUMBER
  BOOLEAN
  DATE
  CHECKBOX
  CHECKLIST
  PHOTO
  SIGNATURE
}

enum MaintenanceItemStatus {
  PENDING
  OK
  FAIL
  NA
}

enum MaintenanceReportStatus {
  DRAFT
  ASSIGNED
  IN_PROGRESS
  SUBMITTED
  COMPLETED
  APPROVED
  REJECTED
  CANCELLED
}

enum MaintenanceReportState {
  DRAFT
  FINAL
}

enum AttachmentOwnerType {
  WORK_ORDER
  MAINTENANCE_REPORT
  MAINTENANCE_REPORT_ITEM
  ASSET
  SITE
  CUSTOMER
  MAINTENANCE_TEMPLATE
  EMERGENCY_REQUEST
  INVOICE
  INVENTORY_PART
  OTHER
}

enum EmergencyRequestStatus {
  OPEN
  DISPATCHED
  IN_PROGRESS
  DONE
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  GENERATED
  SENT
  PAID
  CANCELLED
}

enum CompanyPlan {
  BASIC
  PRO
  ENTERPRISE
}

// Programas de AnPi Tech que una empresa puede tener contratados.
enum Product {
  MAINTENANCE
  INVENTORY
}

enum InventoryLocationType {
  WAREHOUSE
  RACK
  SHELF
  VAN
}

enum InventoryMovementType {
  INITIAL
  IN
  OUT
  TRANSFER
  ADJUST
}

enum InventoryPurchaseStatus {
  PENDING
  ORDERED
  RECEIVED
  CANCELLED
}

model Company {
  id            String      @id @default(cuid())
  name          String
  slug          String?     @unique
  isActive      Boolean     @default(true)
  existe        Boolean     @default(true)
  plan          CompanyPlan @default(BASIC)
  invoicePrefix String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  users                User[]
  userCompanies        UserCompany[]
  customers            Customer[]
  sites                Site[]
  contacts             Contact[]
  assets               Asset[]
  workOrders           WorkOrder[]
  maintenanceTemplates MaintenanceTemplate[]
  maintenanceReports   MaintenanceReport[]
  attachments          Attachment[]
  counters             CompanyCounter[]
  emergencyRequests    EmergencyRequest[]
  invoices             Invoice[]

  products               CompanyProduct[]
  inventoryCategories    InventoryCategory[]
  inventoryParts         InventoryPart[]
  inventoryPartAliases   InventoryPartAlias[]
  inventoryPartBarcodes  InventoryPartBarcode[]
  inventoryLocations     InventoryLocation[]
  inventoryStocks        InventoryStock[]
  inventoryMovements     InventoryMovement[]
  inventoryPurchaseItems InventoryPurchaseItem[]
}

model User {
  id           String    @id @default(cuid())
  companyId    String?
  name         String
  email        String    @unique
  passwordHash String
  role         UserRole?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  memberships                     UserCompany[]
  createdWorkOrders               WorkOrder[]         @relation("WorkOrderCreatedBy")
  assignedTechnicianWorkOrders    WorkOrder[]         @relation("WorkOrderAssignedTechnician")
  assignedToWorkOrders            WorkOrder[]         @relation("WorkOrderAssignedTo")
  createdMaintenanceReports       MaintenanceReport[] @relation("MaintenanceReportCreatedBy")
  legacyCreatedMaintenanceReports MaintenanceReport[] @relation("MaintenanceReportCreatedByUser")
  completedMaintenanceReports     MaintenanceReport[] @relation("MaintenanceReportCompletedByUser")
  assignedMaintenanceReports      MaintenanceReport[] @relation("MaintenanceReportAssignedTechnician")
  submittedMaintenanceReports     MaintenanceReport[] @relation("MaintenanceReportSubmittedBy")
  reviewedMaintenanceReports      MaintenanceReport[] @relation("MaintenanceReportReviewedBy")
  uploadedAttachments             Attachment[]        @relation("AttachmentUploadedByUser")
  assignedEmergencyRequests       EmergencyRequest[]  @relation("EmergencyRequestAssignedTo")

  assignedInventoryLocations InventoryLocation[]     @relation("InventoryLocationAssignedUser")
  inventoryMovements         InventoryMovement[]     @relation("InventoryMovementUser")
  reviewedInventoryMovements InventoryMovement[]     @relation("InventoryMovementReviewedBy")
  addedInventoryPurchases    InventoryPurchaseItem[] @relation("InventoryPurchaseItemAddedBy")

  @@index([companyId])
  @@index([companyId, role])
}

model UserCompany {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  role      UserRole
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId, role, active])
}

model Customer {
  id        String   @id @default(cuid())
  companyId String
  name      String
  email     String?
  phone     String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sites              Site[]
  assets             Asset[]
  workOrders         WorkOrder[]
  maintenanceReports MaintenanceReport[]
  emergencyRequests  EmergencyRequest[]

  @@index([companyId, name])
}

model Site {
  id         String   @id @default(cuid())
  companyId  String
  customerId String
  name       String
  address    String?
  city       String?
  country    String?
  notes      String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer           Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  contacts           Contact[]
  assets             Asset[]
  workOrders         WorkOrder[]
  maintenanceReports MaintenanceReport[]
  emergencyRequests  EmergencyRequest[]

  @@index([companyId, customerId, name])
}

model Contact {
  id        String   @id @default(cuid())
  companyId String
  siteId    String
  name      String
  email     String?
  phone     String?
  role      String?
  isMain    Boolean  @default(false)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  site    Site    @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([companyId, siteId])
}

model Asset {
  id             String      @id @default(cuid())
  companyId      String
  customerId     String?
  siteId         String?
  name           String
  code           String?
  internalCode   String?
  category       String?
  brand          String?
  model          String?
  serialNumber   String?
  status         AssetStatus @default(ACTIVE)
  installationAt DateTime?
  location       String?
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer           Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  site               Site?               @relation(fields: [siteId], references: [id], onDelete: SetNull)
  workOrders         WorkOrder[]
  maintenanceReports MaintenanceReport[]
  emergencyRequests  EmergencyRequest[]

  @@index([companyId, name])
  @@index([customerId])
  @@index([siteId])
}

model MaintenanceTemplate {
  id          String   @id @default(cuid())
  companyId   String
  name        String?
  title       String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company            Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items              MaintenanceTemplateItem[]
  workOrders         WorkOrder[]
  maintenanceReports MaintenanceReport[]

  @@index([companyId, isActive])
  @@index([companyId, name])
  @@index([companyId, title])
}

model MaintenanceTemplateItem {
  id          String               @id @default(cuid())
  templateId  String
  label       String?
  title       String?
  description String?
  type        MaintenanceItemType?
  valueType   String?
  required    Boolean              @default(false)
  sortOrder   Int                  @default(0)
  itemOrder   Int                  @default(0)
  unit        String?
  helpText    String?
  placeholder String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  template    MaintenanceTemplate     @relation(fields: [templateId], references: [id], onDelete: Cascade)
  reportItems MaintenanceReportItem[]

  @@index([templateId, sortOrder])
  @@index([templateId, itemOrder])
}

model WorkOrder {
  id                    String            @id @default(cuid())
  companyId             String
  customerId            String?
  siteId                String?
  assetId               String?
  createdById           String?
  assignedTechnicianId  String?
  assignedToUserId      String?
  maintenanceTemplateId String?
  code                  String?
  title                 String
  description           String?
  status                WorkOrderStatus   @default(OPEN)
  priority              WorkOrderPriority @default(MEDIUM)
  scheduledFor          DateTime?
  scheduledAt           DateTime?
  startedAt             DateTime?
  completedAt           DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  company             Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer            Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  site                Site?                @relation(fields: [siteId], references: [id], onDelete: SetNull)
  asset               Asset?               @relation(fields: [assetId], references: [id], onDelete: SetNull)
  createdBy           User?                @relation("WorkOrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  assignedTechnician  User?                @relation("WorkOrderAssignedTechnician", fields: [assignedTechnicianId], references: [id], onDelete: SetNull)
  assignedTo          User?                @relation("WorkOrderAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  maintenanceTemplate MaintenanceTemplate? @relation(fields: [maintenanceTemplateId], references: [id], onDelete: SetNull)
  maintenanceReport   MaintenanceReport?
  invoice             Invoice?

  @@index([companyId, status])
  @@index([assignedTechnicianId, status])
  @@index([assignedToUserId, status])
  @@index([customerId])
  @@index([siteId])
  @@index([assetId])
  @@index([maintenanceTemplateId])
  @@index([companyId, code])
}

model MaintenanceReport {
  id                   String                  @id @default(cuid())
  companyId            String
  workOrderId          String?                 @unique
  templateId           String?
  customerId           String?
  siteId               String?
  assetId              String?
  createdById          String?
  createdByUserId      String?
  completedByUserId    String?
  assignedTechnicianId String?
  submittedById        String?
  reviewedById         String?
  status               MaintenanceReportStatus @default(DRAFT)
  state                MaintenanceReportState  @default(DRAFT)

  title           String?
  description     String?
  notes           String?
  summary         String?
  diagnosis       String?
  workPerformed   String?
  recommendations String?
  observations    String?
  technicianNotes String?
  reviewNotes     String?

  laborHours Decimal? @db.Decimal(10, 2)
  laborDays  Decimal? @db.Decimal(10, 2)

  assignedAt  DateTime?
  startedAt   DateTime?
  submittedAt DateTime?
  completedAt DateTime?
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  pdfUrl         String?
  pdfGeneratedAt DateTime?

  company            Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workOrder          WorkOrder?                  @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  template           MaintenanceTemplate?        @relation(fields: [templateId], references: [id], onDelete: SetNull)
  customer           Customer?                   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  site               Site?                       @relation(fields: [siteId], references: [id], onDelete: SetNull)
  asset              Asset?                      @relation(fields: [assetId], references: [id], onDelete: SetNull)
  createdBy          User?                       @relation("MaintenanceReportCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdByUser      User?                       @relation("MaintenanceReportCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)
  completedByUser    User?                       @relation("MaintenanceReportCompletedByUser", fields: [completedByUserId], references: [id], onDelete: SetNull)
  assignedTechnician User?                       @relation("MaintenanceReportAssignedTechnician", fields: [assignedTechnicianId], references: [id], onDelete: SetNull)
  submittedBy        User?                       @relation("MaintenanceReportSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  reviewedBy         User?                       @relation("MaintenanceReportReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  items              MaintenanceReportItem[]
  materials          MaintenanceReportMaterial[]
  invoice            Invoice?

  @@index([companyId, status])
  @@index([assignedTechnicianId, status])
  @@index([templateId])
  @@index([customerId])
  @@index([siteId])
  @@index([assetId])
}

model MaintenanceReportItem {
  id             String                @id @default(cuid())
  reportId       String
  templateItemId String?
  label          String?
  title          String?
  description    String?
  type           MaintenanceItemType?
  valueType      String?
  required       Boolean               @default(false)
  sortOrder      Int                   @default(0)
  itemOrder      Int                   @default(0)
  unit           String?
  status         MaintenanceItemStatus @default(PENDING)
  value          String?
  notes          String?

  valueText    String?
  valueNumber  Float?
  valueBoolean Boolean?
  valueDate    DateTime?
  valueJson    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  report       MaintenanceReport        @relation(fields: [reportId], references: [id], onDelete: Cascade)
  templateItem MaintenanceTemplateItem? @relation(fields: [templateItemId], references: [id], onDelete: SetNull)

  @@index([reportId, sortOrder])
  @@index([reportId, itemOrder])
  @@index([templateItemId])
}

model MaintenanceReportMaterial {
  id            String   @id @default(cuid())
  reportId      String
  name          String
  description   String?
  quantity      Float    @default(1)
  unit          String?
  sortOrder     Int      @default(0)
  notes         String?
  unitCost      Decimal? @db.Decimal(10, 2)
  totalCost     Decimal? @db.Decimal(10, 2)
  billable      Boolean  @default(true)
  pricedByAdmin Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  report       MaintenanceReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  invoiceItems InvoiceItem[]

  @@index([reportId, sortOrder])
}

model Attachment {
  id               String              @id @default(cuid())
  companyId        String?
  ownerType        AttachmentOwnerType
  ownerId          String
  name             String?
  fileName         String?
  filename         String?
  originalName     String?
  mimeType         String?
  contentType      String?
  path             String?
  url              String?
  storageKey       String?
  size             Int?
  sizeBytes        Int?
  uploadedByUserId String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  company        Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  uploadedByUser User?    @relation("AttachmentUploadedByUser", fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([ownerType, ownerId])
}

model CompanyCounter {
  id        String   @id @default(cuid())
  companyId String
  key       String
  value     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, key])
}

model EmergencyRequest {
  id               String                 @id @default(cuid())
  companyId        String
  customerId       String?
  siteId           String?
  assetId          String?
  assignedToUserId String?
  title            String
  description      String?
  status           EmergencyRequestStatus @default(OPEN)
  priority         WorkOrderPriority      @default(MEDIUM)
  requestedByName  String?
  requestedByPhone String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  site       Site?     @relation(fields: [siteId], references: [id], onDelete: SetNull)
  asset      Asset?    @relation(fields: [assetId], references: [id], onDelete: SetNull)
  assignedTo User?     @relation("EmergencyRequestAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  @@index([companyId, status])
  @@index([customerId])
  @@index([siteId])
  @@index([assetId])
  @@index([assignedToUserId])
}

model Invoice {
  id                  String        @id @default(cuid())
  companyId           String
  workOrderId         String?       @unique
  maintenanceReportId String?       @unique
  invoiceNumber       String?       @unique
  status              InvoiceStatus @default(DRAFT)
  currency            String        @default("EUR")

  laborAmount     Decimal? @db.Decimal(10, 2)
  materialsAmount Decimal? @db.Decimal(10, 2)
  subtotal        Decimal? @db.Decimal(10, 2)
  taxRate         Decimal? @db.Decimal(5, 2)
  taxAmount       Decimal? @db.Decimal(10, 2)
  total           Decimal? @db.Decimal(10, 2)

  notes       String?
  pdfUrl      String?
  generatedAt DateTime?
  sentAt      DateTime?
  paidAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workOrder         WorkOrder?         @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  maintenanceReport MaintenanceReport? @relation(fields: [maintenanceReportId], references: [id], onDelete: SetNull)
  items             InvoiceItem[]

  @@index([companyId, status])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  action      String
  companyId   String?
  targetPath  String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([actorUserId, createdAt])
  @@index([companyId, createdAt])
}

model InvoiceItem {
  id                          String   @id @default(cuid())
  invoiceId                   String
  maintenanceReportMaterialId String?
  description                 String
  quantity                    Float    @default(1)
  unit                        String?
  unitPrice                   Decimal? @db.Decimal(10, 2)
  lineTotal                   Decimal? @db.Decimal(10, 2)
  sortOrder                   Int      @default(0)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  invoice                   Invoice                    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  maintenanceReportMaterial MaintenanceReportMaterial? @relation(fields: [maintenanceReportMaterialId], references: [id], onDelete: SetNull)

  @@index([invoiceId, sortOrder])
  @@index([maintenanceReportMaterialId])
}

// ============================================================================
// Plataforma AnPi Tech: programas contratados por empresa
// ============================================================================

model CompanyProduct {
  id        String      @id @default(cuid())
  companyId String
  product   Product
  plan      CompanyPlan @default(BASIC)
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, product])
}

// ============================================================================
// Inventorio
// ============================================================================

model InventoryCategory {
  id        String   @id @default(cuid())
  companyId String
  name      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parts   InventoryPart[]

  @@unique([companyId, name])
  @@index([companyId, sortOrder])
}

model InventoryPart {
  id           String   @id @default(cuid())
  companyId    String
  categoryId   String?
  name         String
  reference    String?
  brand        String?
  // ud, m, kg, l, caja, rollo, par
  unit         String   @default("ud")
  // Formato de compra: "caja" de 130, "rollo" de 50 m
  packLabel    String?
  packSize     Decimal? @db.Decimal(12, 3)
  minStock     Decimal? @db.Decimal(12, 3)
  // Recambios: cliente o máquina para los que se compró
  purchasedFor String?
  notes        String?
  // Nombre, referencia, marca y apodos en minúsculas y sin tildes
  searchText   String   @default("")
  isArchived   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company       Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category      InventoryCategory?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  aliases       InventoryPartAlias[]
  barcodes      InventoryPartBarcode[]
  stocks        InventoryStock[]
  movements     InventoryMovement[]
  purchaseItems InventoryPurchaseItem[]

  @@index([companyId, name])
  @@index([companyId, categoryId])
  @@index([companyId, reference])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
}

model InventoryPartAlias {
  id        String   @id @default(cuid())
  companyId String
  partId    String
  alias     String
  createdAt DateTime @default(now())

  company Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  part    InventoryPart @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@unique([partId, alias])
  @@index([companyId])
}

model InventoryPartBarcode {
  id        String   @id @default(cuid())
  companyId String
  partId    String
  code      String
  createdAt DateTime @default(now())

  company Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  part    InventoryPart @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@unique([companyId, code])
  @@index([partId])
}

model InventoryLocation {
  id             String                @id @default(cuid())
  companyId      String
  parentId       String?
  type           InventoryLocationType
  // Código corto que va en la etiqueta: E1, E1-B2, F1
  code           String
  name           String
  assignedUserId String?
  notes          String?
  sortOrder      Int                   @default(0)
  isActive       Boolean               @default(true)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  company       Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent        InventoryLocation?  @relation("InventoryLocationTree", fields: [parentId], references: [id], onDelete: NoAction)
  children      InventoryLocation[] @relation("InventoryLocationTree")
  assignedUser  User?               @relation("InventoryLocationAssignedUser", fields: [assignedUserId], references: [id], onDelete: SetNull)
  stocks        InventoryStock[]
  movementsFrom InventoryMovement[] @relation("InventoryMovementFrom")
  movementsTo   InventoryMovement[] @relation("InventoryMovementTo")

  @@unique([companyId, code])
  @@index([companyId, parentId])
  @@index([assignedUserId])
}

model InventoryStock {
  id         String   @id @default(cuid())
  companyId  String
  partId     String
  locationId String
  quantity   Decimal  @default(0) @db.Decimal(12, 3)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company  Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  part     InventoryPart     @relation(fields: [partId], references: [id], onDelete: Cascade)
  location InventoryLocation @relation(fields: [locationId], references: [id], onDelete: NoAction)

  @@unique([partId, locationId])
  @@index([companyId, locationId])
}

model InventoryMovement {
  id             String                @id @default(cuid())
  companyId      String
  // Generado por el móvil: evita duplicados al sincronizar sin señal
  clientId       String?
  type           InventoryMovementType
  partId         String
  quantity       Decimal               @db.Decimal(12, 3)
  fromLocationId String?
  toLocationId   String?
  userId         String?
  // Obra u orden de trabajo, como texto en la v1
  jobRef         String?
  note           String?
  // Marcado al sincronizar si el stock no cuadraba
  needsReview    Boolean               @default(false)
  reviewedAt     DateTime?
  reviewedById   String?
  // Cuándo ocurrió en el móvil (puede ser antes de llegar al servidor)
  occurredAt     DateTime              @default(now())
  createdAt      DateTime              @default(now())

  company      Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  part         InventoryPart      @relation(fields: [partId], references: [id], onDelete: NoAction)
  fromLocation InventoryLocation? @relation("InventoryMovementFrom", fields: [fromLocationId], references: [id], onDelete: NoAction)
  toLocation   InventoryLocation? @relation("InventoryMovementTo", fields: [toLocationId], references: [id], onDelete: NoAction)
  user         User?              @relation("InventoryMovementUser", fields: [userId], references: [id], onDelete: SetNull)
  reviewedBy   User?              @relation("InventoryMovementReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([companyId, clientId])
  @@index([companyId, partId, createdAt])
  @@index([companyId, createdAt])
  @@index([companyId, needsReview])
  @@index([userId])
}

model InventoryPurchaseItem {
  id          String                  @id @default(cuid())
  companyId   String
  partId      String?
  // Para lo que aún no está en el catálogo
  description String?
  quantity    Decimal                 @db.Decimal(12, 3)
  status      InventoryPurchaseStatus @default(PENDING)
  addedById   String?
  note        String?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  company Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  part    InventoryPart? @relation(fields: [partId], references: [id], onDelete: SetNull)
  addedBy User?          @relation("InventoryPurchaseItemAddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  @@index([companyId, status])
}
